# Spring Boot reads these values from the shell environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hssa_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Usually the same verified mailbox as MAIL_USERNAME.
MAIL_FROM=
FRONTEND_URL=http://localhost:5173
# Public OAuth 2.0 Web Client ID from Google Cloud Console (not a client secret).
GOOGLE_CLIENT_ID=
